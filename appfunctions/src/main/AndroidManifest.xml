<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_metadata" />

        <!-- Generated by KSP from BaseDocumentSearchService. The function inside is disabled by default and only
             switched on from Settings; the system never binds this service below Android 16. -->
        <service
            android:name=".DocumentSearchService"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.v2"
                android:value="document_search_functions.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
